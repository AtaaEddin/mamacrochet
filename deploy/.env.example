# hanadicrochet production configuration (plan 10).
#
# Copy to .env and edit — .env is gitignored, NEVER commit it.
#   cp .env.example .env

# --- Public site -----------------------------------------------------------
# Caddy's site address.
#   http://                          → plain HTTP on HTTP_PORT (LAN / IP use)
#   hanadicrochet.example.com          → automatic HTTPS (Let's Encrypt)
# Bare domain, no scheme, no path, no port.
CADDY_SITE=http://

# Full public URL of the site (used for metadata / canonical URLs in the
# frontend). Example: https://hanadicrochet.example.com
# Leave EMPTY when CADDY_SITE is http://. Rebuild the web image if you
# change this (Next inlines NEXT_PUBLIC_* at build time).
MM_SITE_URL=

# Host port the site listens on (443 is always mapped; it only serves
# traffic when CADDY_SITE is a real domain).
HTTP_PORT=80

# --- PostgreSQL -------------------------------------------------------------
# Internal to the compose network — nothing outside the stack can reach it,
# but use a long random password anyway (it is stored in .env).
POSTGRES_USER=hanadicrochet
POSTGRES_PASSWORD=CHANGE-ME-long-random-string
POSTGRES_DB=hanadicrochet

# --- Admin bootstrap (auto-seeded admin) ---------------------------------------
# Optional. When unset, the api generates a strong random password on the
# first seed and logs it ONCE (see README "Admin account"). Setting
# ADMIN_SEED_PASSWORD pins the initial password instead (fresh installs only —
# a later (re)start never overwrites a changed password). Leave the password
# line empty (= unset) to use the generated one.
#ADMIN_SEED_EMAIL=admin@your-domain.com
ADMIN_SEED_PASSWORD=

# --- Backups (backup.sh) -----------------------------------------------------
# How many daily backups to keep in ./backups/ (oldest deleted).
KEEP_BACKUPS=7
